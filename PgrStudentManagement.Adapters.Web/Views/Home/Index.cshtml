@{
    ViewData["Title"] = "Clean Architecture - Student Management";
}

<div class="p-5 mb-4 bg-light rounded-3 shadow-sm">
    <div class="container-fluid py-2">
        <h1 class="display-6 fw-bold">Clean Architecture PGR Student Management</h1>
        <p class="col-md-9 fs-5 text-muted">
            Demonstrating Clean Architecture with dual incoming adapters (MVC Razor &amp; REST API)
            invoking a shared Business use case (<code>W5-UC01: View Student Enrolments</code>) and persistence gateway.
        </p>
    </div>
</div>

<div class="row align-items-md-stretch g-4 mb-4">
    <div class="col-md-6">
        <div class="h-100 p-4 text-bg-dark rounded-3 shadow-sm">
            <h2>MVC Razor Adapter</h2>
            <p>View student enrolments rendered on the server with Razor views.</p>
            <div class="list-group list-group-flush bg-transparent">
                <a href="/Students/Enrolments?studentNumber=S100001" class="list-group-item list-group-item-action list-group-item-dark d-flex justify-content-between align-items-center">
                    <span><strong>S100001</strong> (Single enrolment)</span>
                    <span class="badge bg-primary rounded-pill">View &rarr;</span>
                </a>
                <a href="/Students/Enrolments?studentNumber=S100002" class="list-group-item list-group-item-action list-group-item-dark d-flex justify-content-between align-items-center">
                    <span><strong>S100002</strong> (Multiple enrolments, chronological)</span>
                    <span class="badge bg-primary rounded-pill">View &rarr;</span>
                </a>
                <a href="/Students/Enrolments?studentNumber=S100003" class="list-group-item list-group-item-action list-group-item-dark d-flex justify-content-between align-items-center">
                    <span><strong>S100003</strong> (Unspecified expected end date)</span>
                    <span class="badge bg-primary rounded-pill">View &rarr;</span>
                </a>
                <a href="/Students/Enrolments?studentNumber=S100004" class="list-group-item list-group-item-action list-group-item-dark d-flex justify-content-between align-items-center">
                    <span><strong>S100004</strong> (No enrolments recorded)</span>
                    <span class="badge bg-secondary rounded-pill">View &rarr;</span>
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="h-100 p-4 bg-light border rounded-3 shadow-sm">
            <h2>REST API Adapter</h2>
            <p>Access the same use-case facts via RESTful JSON endpoints.</p>
            <div class="list-group list-group-flush">
                <a href="/api/students/S100001/enrolments" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <code>/api/students/S100001/enrolments</code>
                    <span class="badge bg-info text-dark rounded-pill">JSON</span>
                </a>
                <a href="/api/students/S100002/enrolments" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <code>/api/students/S100002/enrolments</code>
                    <span class="badge bg-info text-dark rounded-pill">JSON</span>
                </a>
                <a href="/api/students/S100003/enrolments" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <code>/api/students/S100003/enrolments</code>
                    <span class="badge bg-info text-dark rounded-pill">JSON</span>
                </a>
                <a href="/api/students/S100004/enrolments" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <code>/api/students/S100004/enrolments</code>
                    <span class="badge bg-secondary rounded-pill">Empty 200 OK</span>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row align-items-md-stretch g-4">
    <div class="col-md-6">
        <div class="h-100 p-4 bg-white border rounded-3 shadow-sm">
            <h3 class="h4">Research Activities (Extensions 1 &amp; 2 - MVC)</h3>
            <p class="text-muted small">Record research activities (W5-UC04) and view student activities log (W5-UC03).</p>
            <div class="d-flex flex-column gap-2">
                <a href="/ResearchActivities/Record?studentNumber=S100001" class="btn btn-outline-primary d-flex justify-content-between align-items-center">
                    <span><strong>Record Activity (S100001)</strong></span>
                    <span>&rarr;</span>
                </a>
                <a href="/ResearchActivities?studentNumber=S100001" class="btn btn-outline-secondary d-flex justify-content-between align-items-center">
                    <span><strong>View Activities (S100001)</strong></span>
                    <span>&rarr;</span>
                </a>
                <a href="/ResearchActivities?studentNumber=S100002" class="btn btn-outline-secondary d-flex justify-content-between align-items-center">
                    <span><strong>View Activities (S100002)</strong></span>
                    <span>&rarr;</span>
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="h-100 p-4 bg-white border rounded-3 shadow-sm">
            <h3 class="h4">Research Activities (Extensions 1 &amp; 2 - API)</h3>
            <p class="text-muted small">Document-based research activity endpoints (JSON input &amp; output).</p>
            <div class="list-group list-group-flush">
                <a href="/api/students/S100001/research-activities" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <code>GET /api/students/S100001/research-activities</code>
                    <span class="badge bg-info text-dark rounded-pill">JSON</span>
                </a>
                <a href="/api/students/S100002/research-activities" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <code>GET /api/students/S100002/research-activities</code>
                    <span class="badge bg-info text-dark rounded-pill">JSON</span>
                </a>
                <div class="list-group-item text-muted small">
                    <code>POST /api/students/{id}/research-activities</code> (Accepts JSON payload to record activity)
                </div>
            </div>
        </div>
    </div>
</div>
