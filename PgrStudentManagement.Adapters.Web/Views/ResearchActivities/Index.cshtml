@model PgrStudentManagement.Adapters.Web.ViewModels.StudentResearchActivitiesViewModel

@{
    ViewData["Title"] = "Student Research Activities";
}

<div class="container py-3">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h2 mb-1">Student Research Activities</h1>
            <p class="text-muted mb-0">Chronological research log for postgraduate researcher (W5-UC03).</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Record" asp-route-studentNumber="@Model.StudentNumber" class="btn btn-primary btn-sm">
                + Record New Activity
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                &larr; Back to Dashboard
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <strong>Success:</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card mb-4 border-0 shadow-sm bg-light">
        <div class="card-body py-3 px-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <span class="text-uppercase text-secondary fw-semibold me-3 small">Student Number:</span>
                <span class="badge bg-primary fs-6 px-3 py-2 font-monospace">@Model.StudentNumber</span>
            </div>
            <div class="small">
                <a asp-controller="Students" asp-action="Enrolments" asp-route-studentNumber="@Model.StudentNumber" class="text-decoration-none">
                    View Enrolments &rarr;
                </a>
            </div>
        </div>
    </div>

    @if (!Model.HasActivities)
    {
        <div class="alert alert-info d-flex align-items-center shadow-sm" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-info-circle-fill flex-shrink-0 me-3" viewBox="0 0 16 16">
                <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2"/>
            </svg>
            <div>
                <strong>No research activities found</strong>
                <div class="small">No research activities have been logged for this student yet. Click "Record New Activity" above to create one.</div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col" class="ps-4">Date</th>
                            <th scope="col">Type</th>
                            <th scope="col">Title</th>
                            <th scope="col">Tags</th>
                            <th scope="col">Details / Notes</th>
                            <th scope="col" class="pe-4 text-end">Recorded On</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var activity in Model.Activities)
                    {
                        <tr>
                            <td class="ps-4 text-nowrap fw-semibold">@activity.ActivityDate</td>
                            <td>
                                <span class="badge bg-secondary">@activity.ActivityType</span>
                            </td>
                            <td class="fw-medium text-dark">@activity.Title</td>
                            <td>
                                @if (activity.Tags != "None")
                                {
                                    @foreach (var tag in activity.Tags.Split(',', StringSplitOptions.TrimEntries))
                                    {
                                        <span class="badge bg-light text-dark border me-1">@tag</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">None</span>
                                }
                            </td>
                            <td class="small text-muted">
                                @if (activity.Details.TryGetValue("Notes", out var notes))
                                {
                                    <span>@notes</span>
                                }
                                else if (activity.Details.Count > 0)
                                {
                                    <span>@string.Join("; ", activity.Details.Select(kv => $"{kv.Key}: {kv.Value}"))</span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td class="pe-4 text-end text-muted small text-nowrap">@activity.CreatedOn</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
