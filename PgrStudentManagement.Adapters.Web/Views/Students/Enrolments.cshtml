@model PgrStudentManagement.Adapters.Web.ViewModels.StudentEnrolmentsViewModel

@{
    ViewData["Title"] = "Student Enrolments";
}

<div class="container py-3">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h2 mb-1">Student Enrolments</h1>
            <p class="text-muted mb-0">Review postgraduate research student enrolment records.</p>
        </div>
        <div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                &larr; Back to Dashboard
            </a>
        </div>
    </div>

    <div class="card mb-4 border-0 shadow-sm bg-light">
        <div class="card-body py-3 px-4 d-flex align-items-center">
            <span class="text-uppercase text-secondary fw-semibold me-3 small">Student Number:</span>
            <span class="badge bg-primary fs-6 px-3 py-2 font-monospace">@Model.StudentNumber</span>
        </div>
    </div>

    @if (!Model.HasEnrolments)
    {
        <div class="alert alert-info d-flex align-items-center shadow-sm" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-info-circle-fill flex-shrink-0 me-3" viewBox="0 0 16 16">
                <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2"/>
            </svg>
            <div>
                <strong>No enrolments found</strong>
                <div class="small">No active or historical enrolments are recorded for this student number.</div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col" class="ps-4">Programme</th>
                            <th scope="col">Start Date</th>
                            <th scope="col">Expected End Date</th>
                            <th scope="col">Mode of Study</th>
                            <th scope="col" class="pe-4 text-end">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var enrolment in Model.Enrolments)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-primary">@enrolment.ProgrammeCode</td>
                            <td>@enrolment.StartDate</td>
                            <td>
                                @if (enrolment.ExpectedEndDate == "Not recorded")
                                {
                                    <span class="text-muted fst-italic">Not recorded</span>
                                }
                                else
                                {
                                    <span>@enrolment.ExpectedEndDate</span>
                                }
                            </td>
                            <td>@enrolment.ModeOfStudy</td>
                            <td class="pe-4 text-end">
                                <span class="badge @(enrolment.Status == "Active" ? "bg-success" : enrolment.Status == "Completed" ? "bg-info text-dark" : "bg-warning text-dark")">
                                    @enrolment.Status
                                </span>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
